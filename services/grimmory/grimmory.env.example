# Copy this file to /var/lib/homelab/grimmory/grimmory.env on the server.
# Replace both CHANGE_ME values with long, unique passwords before starting.

# Grimmory Application Settings
APP_USER_ID=1000
APP_GROUP_ID=100
TZ=Europe/Paris
SERVER_PORT=6060

# Database Connection (Grimmory)
DATABASE_URL=jdbc:mariadb://mariadb:3306/grimmory
DB_USER=grimmory
DB_PASSWORD=CHANGE_ME_grimmory_database_password

# MariaDB Container Settings
DB_USER_ID=1000
DB_GROUP_ID=100
MYSQL_ROOT_PASSWORD=CHANGE_ME_mariadb_root_password
MYSQL_DATABASE=grimmory
